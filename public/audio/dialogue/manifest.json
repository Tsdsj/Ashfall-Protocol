    },
    {
      "id": "shelf-collapse",
      "file": "shelf-collapse.mp3",
      "speaker": "你",
      "title": "货架后的刻痕",
      "text": "货架倒下，露出墙上按日期刻的身高线。最后一道写着十月十六日。有人在“全部撤离”之后，又在这里过了一次生日。",
      "delivery": "voice",
      "voices": [
        "zm_010"
      ],
      "textSha256": "e782324de12c1249498e24e8cd414228052255f27218140296a5db0403eee31b",
      "duration": 14.075,
      "peakDbFS": -4.55,
      "bytes": 113324,
      "sha256": "2e0904a7fa332abf1228ae9bf8dc442a46b0a18412043d28db963c6b10926ea7"
    },
    {
      "id": "fort-alarm",
      "file": "fort-alarm.mp3",
      "speaker": "军事警报",
      "title": "未经登记的生命",
      "text": "周界检测到未经登记的生命活动。停止向大门聚集。重复：救援车不会进入封锁区。附近感染者被警报引向围墙。",
      "delivery": "radio",
      "voices": [
        "zm_010"
      ],
      "textSha256": "a53e6c49209e633e183e423f096fca6c79ee82bb4ef4d0c589557e395567ab7d",
      "duration": 16.0,
      "peakDbFS": -4.35,
      "bytes": 128684,
      "sha256": "48c5bd58be07718954739062609a3e85a517180933518dc09f5d9b1ef51e77f3"
    },
    {
      "id": "doctor-request",
      "file": "doctor-request.mp3",
      "speaker": "米拉",
      "title": "没有回来的医生",
      "text": "你：还有谁在救人？\n米拉：韩医生去矿场诊所取转院底单，昨天该回来了。带两卷绷带去。他总说伤口不大，那往往是最需要包扎的时候。",
      "delivery": "dialogue",
      "voices": [
        "zf_001",
        "zm_010"
      ],
      "textSha256": "2f58db79a50de26a87b8c6a6203c32a9cea075679c481ef5ebaea1607d6ebfa3",
      "duration": 16.7,
      "peakDbFS": -4.27,
      "bytes": 134252,
      "sha256": "7aead52660b0ebeb1644a7bb92195bb23c766a4f8249d24670fe85c15208e79e"
    },
    {
      "id": "doctor-found",
      "file": "doctor-found.mp3",
      "speaker": "韩医生",
      "title": "迟到的病历",
      "text": "韩医生：我没被抓，只是脚走不了了。谢谢你的绷带。这里有完整的转院底单，能证明患者在封锁前就被送进地下。\n你：我带你回去。\n韩医生：我沿林线慢慢走。你先把底单送到米拉手里，别让我的腿把证据也困住。",
      "delivery": "dialogue",
      "voices": [
        "zm_010"
      ],
      "textSha256": "9b2214b843fa81eeaa6462bc1a4578f37f5e3c27b75c90d708889befc91aaf95",
      "duration": 24.125,
      "peakDbFS": -3.93,
      "bytes": 193772,
      "sha256": "de13dc36d25da9df7f277f0d418dd8de4fd304940f517b56a9c7ff11bf7abf8d"
    },
    {
      "id": "doctor-return",
      "file": "doctor-return.mp3",
      "speaker": "米拉",
      "title": "名字留在病历上",
      "text": "韩医生的脚步声我认得，他已经到了后屋。底单和我的记录对上了。你留着抗生素，还有这张急救包配方。我们能做的治疗很少，但每个病历都必须留下名字。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "9d880476b40cd38b7cf6a6c8dfb5ae8772de9d0740f8f44129351139890876bb",
      "duration": 18.9,
      "peakDbFS": -5.19,
      "bytes": 151916,
      "sha256": "c6125e49fbf41e0ef41eb537d642133ab0fa0b3604d1821113b1db42425d9500"
    },
    {
      "id": "hunter-request",
      "file": "hunter-request.mp3",
      "speaker": "罗岚",
      "title": "湖边的家人",
      "text": "我妻子带孩子往林边住宅去了。她不会走大路，沿途会留下三道斜杠。找到她们，带一罐肉和一瓶水；别开枪报信，湖那头什么都听得见。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "6706354962e869fd7bbdfad9249cc915ac918fbce09cb2c09dc4b68024dae9dd",
      "duration": 17.725,
      "peakDbFS": -5.75,
      "bytes": 142508,
      "sha256": "73f951f3f10331160d916dca4a4f29785d5728104dfe53da45adbca2bf67fce6"
    },
    {
      "id": "hunter-route",
      "file": "hunter-route.mp3",
      "speaker": "许禾",
      "title": "三道斜杠",
      "text": "你：罗岚还在湖边等。\n许禾：孩子扭伤了脚，我们等雾散才走。这是巡林小路，绕开军方探照灯。把路线交给他，也交给别的想活下去的人。",
      "delivery": "dialogue",
      "voices": [
        "zf_001",
        "zm_010"
      ],
      "textSha256": "bc4715ab7163697835ec38ceedd2da4b74ded100deac1ac53acad8726a9230b8",
      "duration": 17.125,
      "peakDbFS": -5.66,
      "bytes": 137708,
      "sha256": "5c955b97f7f41cc55fcb4394901cf44d1b38e72ce27cb9adea0fd595bb401df3"
    },
    {
      "id": "hunter-return",
      "file": "hunter-return.mp3",
      "speaker": "罗岚",
      "title": "有人等你回家",
      "text": "她们到岸边了。孩子说你给的肉有节日的味道。我把钓竿给你，也把这条湖岸路线标好。它不是安全的保证，只是比公路多一点活下去的机会。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "b57c83f6657ca4646bcc061267bd551e8b79c2e9c2e8c042b51c0049f2c208cf",
      "duration": 17.4,
      "peakDbFS": -4.56,
      "bytes": 139820,
      "sha256": "3f051738c75dc27a5ab6908f586ecd2143519dc15cf0b453de510dfa7e4dc320"
    },
    {
      "id": "checkpoint-request",
      "file": "checkpoint-request.mp3",
      "speaker": "守卫阿衡",
      "title": "没有发出的口粮",
      "text": "检查站被弃了，但仓库还有一批写着“已派发”的药箱。后勤仓库的封条能证明东西根本没出去。把它带回来，我就打开侧门；别让后来的人还在正门排队。",
      "delivery": "dialogue",
      "voices": [
        "zm_010"
      ],
      "textSha256": "6cd91cc3c2cb357d5df96ca6d7e9ca5e0244db6b63d0054e7620bec79bd19775",
      "duration": 18.675,
      "peakDbFS": -4.34,
      "bytes": 150188,
      "sha256": "6c6fee2fd8d10d5cc6a256aab1a19c7d094961f3ad87b87cbc6ef1b6b8c5d9eb"
    },
    {
      "id": "checkpoint-proof",
      "file": "checkpoint-proof.mp3",
      "speaker": "后勤交接录音",
      "title": "空白的签收人",
      "text": "账上口粮四百份，发放人数零。最后一道命令要求把收据盖完章再撤。箱子留在原处，封条背面写着守卫阿衡的交接时间，他不是丢下这些东西逃走的那一个。",
      "delivery": "log",
      "voices": [
        "zm_010"
      ],
      "textSha256": "0cb4289589e97e2e7e600e50b0cf24324c139c271904270e6020304c1a03454a",
      "duration": 18.1,
      "peakDbFS": -5.82,
      "bytes": 145580,
      "sha256": "be49cbf74c2d981b0c02972fa6fcecdaeb126bf9081c08405e0fc3a7c821e133"
    },
    {
      "id": "checkpoint-return",
      "file": "checkpoint-return.mp3",
      "speaker": "守卫阿衡",
      "title": "打开侧门",
      "text": "谢谢。现在大家知道不是我们把药吃了。侧门留给还在走路的人，这件背心给你。我守着这里，不再检查谁有没有登记。",
      "delivery": "dialogue",
      "voices": [
        "zm_010"
      ],
      "textSha256": "254fa5dd26dfc8fa34715f6aacfb6ae3c7ee06bd09722f26f73db339364b24ce",
      "duration": 15.35,
      "peakDbFS": -5.31,
      "bytes": 123500,
      "sha256": "54509d70aa89ec5bd3344d9e497e3f52b245717f73c98e0963bdc3a707c40a2b"
    },
    {
      "id": "raider-request",
      "file": "raider-request.mp3",
      "speaker": "旅馆炊事员陈娅",
      "title": "一锅人的份量",
      "text": "工业区的人抢走了我们的滤芯。他们的头领叫唐砾，以前是货运调度。带两罐豆子去谈，他知道弹药填不饱肚子。告诉他，旅馆愿意按人数分水，别再按枪分。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "d75bd764ae249cef42a3bfc8306700870df07f7cc79ead6f13ff35cbd6df4fd0",
      "duration": 19.025,
      "peakDbFS": -4.77,
      "bytes": 152876,
      "sha256": "4bd2d9fcf43a06b036fede7eeed4b49dd5266d8e3e1422bba831cef23ecf25f2"
    },
    {
      "id": "raider-deal",
      "file": "raider-deal.mp3",
      "speaker": "唐砾",
      "title": "另一本账",
      "text": "唐砾：你就带这个来？\n你：两罐豆子。和一份每个人都能喝水的约定。\n唐砾：……滤芯拿回去。告诉陈娅，算上我们六个人。我会撤掉地铁口的拦路队，但有人饿着，约定就会坏。",
      "delivery": "dialogue",
      "voices": [
        "zm_010"
      ],
      "textSha256": "088fd488576586622e4766bd2c39ec6e99e5844da9f2c9e657b2554285fba8e7",
      "duration": 21.1,
      "peakDbFS": -5.08,
      "bytes": 169580,
      "sha256": "7cf1818f4f5b5a8e734d6b8aa8bc671167890c4cef6d3c5fbed412c881134ab0"
    },
    {
      "id": "raider-return",
      "file": "raider-return.mp3",
      "speaker": "陈娅",
      "title": "第七把椅子",
      "text": "滤芯装上了。我给唐砾他们留了六份，再给送东西的人留一份。消声器是老房客留下的，你比我用得上。地铁通道已经撤了路障，谁都别再把这条路当领地。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "68068d49ad3dcf1cf0de89371ce16fcbb6aec5820334eadeab10c43127f96bc8",
      "duration": 18.475,
      "peakDbFS": -6.26,
      "bytes": 148460,
      "sha256": "56848235a93f435067b84bc11192867ba4e08a1a76c9704b2b21a26391300b1d"
    },
    {
      "id": "radio-request",
      "file": "radio-request.mp3",
      "speaker": "乔榆",
      "title": "有人在另一端吗",
      "text": "台里剩的备用线只能接收。去黑岭变电站，把收发器、三个电子元件和一块电池接到中继台。我会留在这里守频段。听见回声时，先别高兴，那可能还是我们自己。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "2cfa8fa6e1bf5a3ecad825abcc6d1cd264a2186d93456ffeba626cf6f9938eed",
      "duration": 19.3,
      "peakDbFS": -5.17,
      "bytes": 155180,
      "sha256": "8a502299c8889db6817841942d940341e15838853cd0c528d2c4d2c5c4487bd2"
    },
    {
      "id": "radio-repair",
      "file": "radio-repair.mp3",
      "speaker": "乔榆",
      "title": "第一次不是回声",
      "text": "收到了，电压稳定。外面的短波台在问坐标，但军方还占着紧急频道。先回来确认频率。等拿到可以核验的档案，我们才能让他们知道这不是一场假警报。",
      "delivery": "radio",
      "voices": [
        "zf_001"
      ],
      "textSha256": "7a9913c3cbbea375860d3469b32ed1e766d0738cc27647c9679d1ca4b734cbd5",
      "duration": 18.225,
      "peakDbFS": -5.97,
      "bytes": 146540,
      "sha256": "8ba9ca84c0c7b8ce4a4ca940a35d039a49c9248dae7bc4e6c105da88a66b25cd"
    },
    {
      "id": "radio-return",
      "file": "radio-return.mp3",
      "speaker": "乔榆",
      "title": "留给真话的频段",
      "text": "线路确认完毕。备用电池给你，这张低耗收发器接线图也带上。别只发送一份文件：带上证人和完整记录，才不会被一句“伪造”抹掉。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "cd09c2b6f50fa9d54b897f4a920004af735313b08aac22780f40378b7ecd9ad3",
      "duration": 15.3,
      "peakDbFS": -5.98,
      "bytes": 123116,
      "sha256": "665e582c962f476561b7698a5d3c8f76ce6bc081866efd31b2b2f35abebafe57"
    },
    {
      "id": "shelter-request",
      "file": "shelter-request.mp3",
      "speaker": "避难所管理员许弥",
      "title": "地下还有灯",
      "text": "地铁门后有十一位老人，储水撑不过今晚。水库值班站的旧泵能接过来，需要两片净水片和一个电子元件。修好后带一份燃料回来，我们把备用机接上。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "08cfa5c0a492a5f9c8ce3d5975951ad5a0a2f5176dd6fae80841dff480f3fe7f",
      "duration": 17.15,
      "peakDbFS": -5.98,
      "bytes": 137900,
      "sha256": "c91196783e8ec3449571da15402cdb955122bce969663cbe6f6a09c4cdfe2c92"
    },
    {
      "id": "shelter-power",
      "file": "shelter-power.mp3",
      "speaker": "许弥",
      "title": "管道里的声音",
      "text": "水到了。先是锈色，现在清了。你修的不是一台泵，是明天早上的十一杯水。备用机还没转，带燃料回来，我们一起看着它启动。",
      "delivery": "radio",
      "voices": [
        "zf_001"
      ],
      "textSha256": "df4fb3575f11c578f40cb8e088b1cbc600c9a0cd054c8d7d636dc3197050b57e",
      "duration": 16.1,
      "peakDbFS": -4.3,
      "bytes": 129452,
      "sha256": "34965353919171ae8cde3cb9612b0d0440797b38e7894412f4b3b1021f7358b8"
    },
    {
      "id": "shelter-return",
      "file": "shelter-return.mp3",
      "speaker": "许弥",
      "title": "明天早上的水",
      "text": "电源接通，储水罐在涨。这是我们的净水余量和循环净水配方。地铁西门会保持打开。你要是决定留下，这里有人愿意轮班，不用一个人守到最后。",
      "delivery": "dialogue",
      "voices": [
        "zf_001"
      ],
      "textSha256": "66714cdc99e5e20ec1af9128e17f130d5874452849971b35226c216f9e44e7ea",
      "duration": 18.1,
      "peakDbFS": -5.56,
      "bytes": 145580,
      "sha256": "64b9d3dfb5b883e6505b8df33e055fff53ef04e8504ebf472c6a5dbf681e6763"
    },
    {
      "id": "officer-request",
      "file": "officer-request.mp3",
      "speaker": "沈维上尉",
      "title": "不删掉我的名字",
      "text": "我说过自己只服从命令，那是我最懦弱的一句话。医疗营房的录音能证明我知道有人没撤离。拿它回来，我会签完整证词，连我没有开门的那一晚也写进去。",
      "delivery": "dialogue",
      "voices": [
        "zm_010"
      ],
      "textSha256": "716899f4d8c9b98ef3537d3eb8b9ce7a3ae57fc05cb8879edbcd09ea010849d6",
      "duration": 17.275,
      "peakDbFS": -3.94,
      "bytes": 138860,
      "sha256": "67a60298270017596b73c5cbdb6b74ac6e9ae3e31ad6d2835e208052bd90744a"
    },
    {
      "id": "officer-proof",
      "file": "officer-proof.mp3",
      "speaker": "医疗营房录音",
      "title": "门外的叩击",
      "text": "军医：门外是平民，没有症状。\n沈维：命令没有例外。\n军医：那你自己告诉他们。\n长达四十秒的静默里，门外始终有人轻轻敲门。随后记录到手动侧门开启。",
      "delivery": "log",
      "voices": [
        "zm_010"
      ],
      "textSha256": "022b9e2871f5c5428d9af5cd148adab47449a20c4f9cca7b4f7f63b3cfb9c4b5",
      "duration": 18.675,
      "peakDbFS": -4.44,
      "bytes": 150188,
      "sha256": "e9cd659bf60b3af9591c66e13cfc87bccc5d9e591a3894b4bba8021cb69c01c6"
    },
    {
      "id": "officer-return",
      "file": "officer-return.mp3",
      "speaker": "沈维上尉",
      "title": "完整证词",
      "text": "我签完了。开侧门不能抵消之前的服从，幸存者也不欠我原谅。证词和隔离阀的手动编号都给你。公开的时候，把我的军衔和名字一起发出去。",
      "delivery": "dialogue",
      "voices": [
        "zm_010"
      ],
      "textSha256": "19627d5e2ecc473e32f99e00c6c44484a7f395e55ed21d23603824ba52e19128",
      "duration": 18.0,
      "peakDbFS": -4.37,
      "bytes": 144620,
      "sha256": "f615fe0c3ef747838c100ed8a1558c967c690dbf5a77a149f1abbc2ccd90c1a5"
    }
  ],
  "totalBytes": 7245756
}

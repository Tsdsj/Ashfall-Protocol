{
  "name": "ashfall-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/create-precache.mjs",
    "build:sites": "npm run build && node scripts/build-sites.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src tests && tsc --noEmit",
    "test:watch": "vitest",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.26.0",
    "@babylonjs/loaders": "8.56.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "fake-indexeddb": "^6.2.2",
    "meshoptimizer": "1.2.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
